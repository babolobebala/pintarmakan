generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "mysql"
}

model User {
  id            String    @id @db.VarChar(191)
  name          String    @db.VarChar(191)
  email         String    @unique @db.VarChar(191)
  emailVerified Boolean   @default(false)
  image         String?   @db.Text
  role          String?   @db.VarChar(191)
  banned        Boolean   @default(false)
  banReason     String?   @db.Text
  banExpires    DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  auditLogs     AuditLog[] @relation("ActorAuditLogs")

  @@map("user")
}

model Session {
  id             String   @id @db.VarChar(191)
  userId         String   @db.VarChar(191)
  token          String   @unique @db.VarChar(191)
  expiresAt      DateTime
  impersonatedBy String? @db.VarChar(191)
  ipAddress      String?  @db.VarChar(191)
  userAgent      String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                     String    @id @db.VarChar(191)
  userId                 String    @db.VarChar(191)
  accountId              String    @db.VarChar(191)
  providerId             String    @db.VarChar(191)
  accessToken            String?   @db.Text
  refreshToken           String?   @db.Text
  idToken                String?   @db.Text
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?
  scope                  String?   @db.Text
  password               String?   @db.Text
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @db.VarChar(191)
  identifier String   @db.VarChar(191)
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
model AuditLog {
  id         String   @id @default(cuid()) @db.VarChar(191)
  actorId    String?  @db.VarChar(191)
  action     String   @db.VarChar(191)
  entityType String   @db.VarChar(191)
  entityId   String?  @db.VarChar(191)
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
